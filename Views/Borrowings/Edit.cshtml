@model Borrowing
@{ ViewData["Title"] = "Edit Borrowing"; }

<div class="page-header">
    <div>
        <a asp-action="GetIndexView" class="eyebrow"><i class="bi bi-arrow-left"></i> Borrowings</a>
        <h1>Edit borrowing</h1>
        <p>If the book is marked as returned late and the fee is left at 0, it is calculated automatically.</p>
    </div>
</div>

<form method="post" asp-action="EditCurrent" class="panel form-panel" style="max-width:720px">
    <input type="hidden" asp-for="Id" />
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-grid">
            <div class="span-2">
                <label asp-for="BookId" class="form-label"></label>
                <select asp-for="BookId" asp-items="ViewBag.AllBooks" class="form-select"></select>
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>
            <div class="span-2">
                <label asp-for="MemberId" class="form-label"></label>
                <select asp-for="MemberId" asp-items="ViewBag.AllMembers" class="form-select"></select>
                <span asp-validation-for="MemberId" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="BorrowDate" class="form-label"></label>
                <input asp-for="BorrowDate" type="date" class="form-control" />
                <span asp-validation-for="BorrowDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" type="date" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="ReturnDate" class="form-label"></label>
                <input asp-for="ReturnDate" type="date" class="form-control" />
                <span asp-validation-for="ReturnDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="LateFee" class="form-label"></label>
                <input asp-for="LateFee" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="LateFee" class="text-danger"></span>
            </div>
            <div class="span-2">
                <div class="switch-row form-switch">
                    <input asp-for="IsReturned" class="form-check-input" role="switch" />
                    <label asp-for="IsReturned" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="form-footer">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i>Save changes</button>
        <a asp-action="GetIndexView" class="btn btn-light-outline">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
