@model Book
@{ ViewData["Title"] = "Delete Book"; }

<div class="page-header">
    <div>
        <a asp-action="GetIndexView" class="eyebrow"><i class="bi bi-arrow-left"></i> Books</a>
        <h1>Delete book</h1>
    </div>
</div>

<div class="panel danger-panel form-panel">
    <div class="danger-head">
        <span class="icon"><i class="bi bi-exclamation-triangle"></i></span>
        <div>
            <h2>Are you sure you want to delete this book?</h2>
            <p>The book and its cover image will be removed permanently.</p>
        </div>
    </div>
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="book-cell">
            <img src="@DisplayHelper.ImageUrl(Model.ImagePath)" class="thumb" style="width:72px;height:100px" alt="" />
            <dl class="detail-list flex-grow-1">
                <dt>@Html.DisplayNameFor(b => b.Title)</dt><dd>@Model.Title</dd>
                <dt>@Html.DisplayNameFor(b => b.AuthorName)</dt><dd>@Model.AuthorName</dd>
                <dt>@Html.DisplayNameFor(b => b.ISBN)</dt><dd>@Model.ISBN</dd>
                <dt>Category / Publisher</dt><dd>@Model.Category.Name · @Model.Publisher.Name</dd>
                <dt>Borrowing records</dt><dd>@Model.Borrowings.Count</dd>
            </dl>
        </div>
    </div>
    <form method="post" asp-action="DeleteCurrent" class="form-footer">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit"><i class="bi bi-trash3"></i>Delete book</button>
        <a asp-action="GetIndexView" class="btn btn-light-outline">Cancel</a>
    </form>
</div>
