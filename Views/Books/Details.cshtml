@model Book
@{ ViewData["Title"] = Model.Title; }

<div class="page-header">
    <div>
        <a asp-action="GetIndexView" class="eyebrow"><i class="bi bi-arrow-left"></i> Books</a>
        <h1>@Model.Title</h1>
        <p>by @Model.AuthorName</p>
    </div>
    <div class="page-actions">
        <a asp-action="GetEditView" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i>Edit</a>
        <a asp-action="GetDeleteView" asp-route-id="@Model.Id" class="btn btn-light-outline"><i class="bi bi-trash3"></i>Delete</a>
    </div>
</div>

<div class="detail-layout">
    <div class="cover-frame"><img src="@DisplayHelper.ImageUrl(Model.ImagePath)" alt="Cover of @Model.Title" /></div>

    <div class="panel">
        <div class="panel-head">
            <h2>Book information</h2>
            @if (Model.IsAvailable)
            {
                <span class="pill pill-ok">Available</span>
            }
            else
            {
                <span class="pill pill-warn">On loan</span>
            }
        </div>
        <div class="panel-body">
            <dl class="detail-list">
                <dt>@Html.DisplayNameFor(b => b.ISBN)</dt><dd>@Model.ISBN</dd>
                <dt>Category</dt><dd><a asp-controller="Categories" asp-action="GetDetailsView" asp-route-id="@Model.Category.Id">@Model.Category.Name</a></dd>
                <dt>Publisher</dt><dd><a asp-controller="Publishers" asp-action="GetDetailsView" asp-route-id="@Model.Publisher.Id">@Model.Publisher.Name</a></dd>
                <dt>@Html.DisplayNameFor(b => b.Price)</dt><dd>@DisplayHelper.Money(Model.Price)</dd>
                <dt>@Html.DisplayNameFor(b => b.PublicationDate)</dt><dd>@DisplayHelper.Date(Model.PublicationDate)</dd>
                <dt>@Html.DisplayNameFor(b => b.Pages)</dt><dd>@Model.Pages</dd>
                <dt>@Html.DisplayNameFor(b => b.Language)</dt><dd>@Model.Language</dd>
                <dt>@Html.DisplayNameFor(b => b.StockQuantity)</dt><dd>@Model.StockQuantity</dd>
                <dt>@Html.DisplayNameFor(b => b.Description)</dt><dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
            </dl>
        </div>
    </div>
</div>

<h2 class="section-title">Borrowing history</h2>
<div class="panel">
    @if (Model.Borrowings.Any())
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Member</th><th>Borrowed</th><th>Due</th><th>Returned</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Borrowings.OrderByDescending(b => b.BorrowDate))
                    {
                        <tr>
                            <td><a asp-controller="Members" asp-action="GetDetailsView" asp-route-id="@item.MemberId" class="cell-title">@item.Member.FullName</a></td>
                            <td>@DisplayHelper.Date(item.BorrowDate)</td>
                            <td>@DisplayHelper.Date(item.DueDate)</td>
                            <td>@DisplayHelper.Date(item.ReturnDate)</td>
                            <td><partial name="_BorrowingStatus" model="item" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state"><i class="bi bi-clock-history"></i><h3>Never borrowed</h3><p>This book has no borrowing records yet.</p></div>
    }
</div>
